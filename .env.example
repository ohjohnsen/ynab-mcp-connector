# Copy to .env and fill in your own values:  cp .env.example .env
# The server only loads .env if the file exists; otherwise it reads plain
# environment variables (e.g. those injected by docker-compose).

# ---------------------------------------------------------------------------
# YNAB API (required)
# ---------------------------------------------------------------------------

# Personal access token from https://app.ynab.com/settings/developer
# Required in OAuth mode, where it is used server-side once a token is verified.
# Not needed in direct bearer token mode, where each request supplies its own.
YNAB_API_KEY=your_ynab_personal_access_token

# YNAB API base URL (v1.85.0). Rarely needs changing.
YNAB_API_URL=https://api.ynab.com/v1

# ---------------------------------------------------------------------------
# OAuth 2.1
#
# Setting both OAUTH_CLIENT_ID and OAUTH_CLIENT_SECRET switches the connector
# into OAuth mode. Leave them unset to instead treat the Authorization header
# as a YNAB personal access token directly.
# ---------------------------------------------------------------------------

# Any values you choose. Used as-is by clients you configure manually
# (e.g. Claude.ai). Generate with: openssl rand -hex 32
OAUTH_CLIENT_ID=choose_any_client_id
# Also the HMAC key signing every issued token, code and dynamic client_id.
# Changing it invalidates all of them, forcing every client to re-authorize.
OAUTH_CLIENT_SECRET=choose_any_client_secret

# Redirect URIs allowed for the client above (comma-separated).
# Clients that register dynamically supply their own instead.
OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback

# Typed into the consent screen to approve a dynamically registered client.
# Defaults to OAUTH_CLIENT_SECRET, but set it separately so you can rotate the
# approval secret without invalidating every issued token.
OAUTH_CONSENT_SECRET=choose_any_approval_secret

# Dynamic client registration (RFC 7591) is required by clients that only ask
# for a server URL, such as Mistral. Set to false to reject registration and
# allow only the pre-configured client above.
OAUTH_DYNAMIC_REGISTRATION_ENABLED=true

# ---------------------------------------------------------------------------
# Server (optional)
# ---------------------------------------------------------------------------

SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# MCP_NAME=YNAB Connector
# MCP_VERSION defaults to the version in pyproject.toml
